{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // No baseUrl: TypeScript 7 removed it, and paths already resolve relative
    // to this file. Mirrors resolve.alias in vite.config.js.
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    // Vite compiles the app and `node --experimental-strip-types` runs the
    // tests, so tsc is only ever a type checker here — it emits nothing.
    "noEmit": true,
    // Both of those strip types file-by-file with no cross-file view, so
    // anything relying on whole-program emit has to be off.
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.js"]
}
